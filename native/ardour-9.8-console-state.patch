+/* Read-only console indicators; does not create or refresh an OSC surface. */
+int
+OSC::procontrol_transport_state (lo_message msg)
+{
+	if (!session) { return -1; }
+	lo_message reply = lo_message_new ();
+	lo_message_add_int32 (reply, 1); // version
+	lo_message_add_int32 (reply, session->config.get_external_sync () ? 1 : 0);
+	lo_message_add_int32 (reply, session->config.get_punch_in () ? 1 : 0);
+	lo_message_add_int32 (reply, session->config.get_punch_out () ? 1 : 0);
+	lo_message_add_int32 (reply, session->get_play_loop () ? 1 : 0);
+	lo_message_add_int32 (reply, (int)session->record_status ());
+	lo_message_add_int32 (reply, session->have_rec_enabled_track () ? 1 : 0);
+	lo_send_message (get_address (msg), X_("/procontrol/transport/state"), reply);
+	lo_message_free (reply);
+	return 0;
+}
