+
+#ifndef __osc_observer_connections_h__
+#define __osc_observer_connections_h__
+
+#include <sigc++/trackable.h>
+#include "pbd/signals.h"
+
+/* Disconnecting a signal does not cancel calls already queued on the OSC
+ * event loop. Tie their invalidators to the connection group, so resetting
+ * a strip, pan, plugin or send bank also cancels its previous callbacks.
+ * All resets and observer destruction occur on the OSC event loop.
+ */
+class OSCObserverConnections : public PBD::ScopedConnectionList, public sigc::trackable
+{
+public:
+    ~OSCObserverConnections () override { drop_connections (); }
+
+    void drop_connections ()
+    {
+        PBD::ScopedConnectionList::drop_connections ();
+        notify_callbacks ();
+    }
+};
+
+#endif
