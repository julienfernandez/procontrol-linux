diff --git a/libs/ardour/session_events.cc b/libs/ardour/session_events.cc
index f79d12b..eb8c770 100644
--- a/libs/ardour/session_events.cc
+++ b/libs/ardour/session_events.cc
@@ -246,8 +246,15 @@ SessionEventManager::merge_event (SessionEvent* ev)
 	default:
 		for (Events::iterator i = events.begin(); i != events.end(); ++i) {
 			if ((*i)->type == ev->type && (*i)->action_sample == ev->action_sample) {
-			  error << string_compose(_("Session: cannot have two events of type %1 at the same sample (%2)."),
-						  enum_2_string (ev->type), ev->action_sample) << endmsg;
+				/* Repeated JACK starts can request the same notification.
+				 * The existing event already covers it, but the rejected
+				 * allocation must still be returned to its owning pool.
+				 */
+				if (ev->type != SessionEvent::TransportStateChange) {
+					error << string_compose(_("Session: cannot have two events of type %1 at the same sample (%2)."),
+					                        enum_2_string (ev->type), ev->action_sample) << endmsg;
+				}
+				delete ev;
 				return;
 			}
 		}
