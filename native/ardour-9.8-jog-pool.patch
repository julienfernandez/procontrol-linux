diff --git a/libs/ardour/session_transport.cc b/libs/ardour/session_transport.cc
index 0790d30..97e6376 100644
--- a/libs/ardour/session_transport.cc
+++ b/libs/ardour/session_transport.cc
@@ -610,6 +610,19 @@ Session::start_transport (bool after_loop)
 	DEBUG_TRACE (DEBUG::Transport, string_compose ("send TSC4 with speed = %1\n", transport_speed()));
 
 	if (!after_loop) {
+		/* A seek may have skipped the notifications from the previous
+		 * start. Replace that pair before scheduling the new one, keeping
+		 * both the start and latency-preroll notifications for this roll.
+		 * Queue the clear: deleting timeline events here could invalidate
+		 * an iterator in process_with_events().
+		 */
+		/* Preroll record trim also queues a notification at record-in;
+		 * that future monitoring change must survive this start.
+		 */
+		if (!_preroll_record_trim_len) {
+			clear_events (SessionEvent::TransportStateChange);
+		}
+
 		/* emit TransportStateChange signal only when transport is actually rolling */
 		SessionEvent* ev = new SessionEvent (SessionEvent::TransportStateChange, SessionEvent::Add, _transport_sample, _transport_sample, 1.0);
 		queue_event (ev);
