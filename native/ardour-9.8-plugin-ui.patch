+int
+OSC::procontrol_plugin_ui_version (lo_message msg)
+{
+	return int_message (X_("/procontrol/plugin_ui/version"), 1, get_address (msg));
+}
+
+int
+OSC::procontrol_plugin_ui_clear (lo_message msg)
+{
+	char* url = lo_address_get_url (get_address (msg));
+	const std::string owner (url ? url : "");
+	free (url);
+	if (owner == _procontrol_plugin_owner) {
+		if (std::shared_ptr<Processor> old = _procontrol_plugin_window.lock ()) {
+			old->HideUI (); // delivered to ProcessorWindowProxy on the GUI thread
+		}
+		_procontrol_plugin_window.reset ();
+		_procontrol_plugin_owner.clear ();
+	}
+	return int_message (X_("/procontrol/plugin_ui/cleared"), 1, get_address (msg));
+}
+
+int
+OSC::procontrol_plugin_ui_show (lo_arg** argv, lo_message msg)
+{
+	const std::string expected_session (&argv[0]->s);
+	const std::string route_id (&argv[1]->s);
+	const int plugin_index = argv[2]->i;
+	const std::string expected_name (&argv[3]->s);
+	int result = -1;
+	uint64_t numeric_id = 0;
+	if (session && session->path () == expected_session && plugin_index > 0 &&
+	    !route_id.empty () && route_id.size () <= 20 &&
+	    route_id.find_first_not_of ("0123456789") == std::string::npos &&
+	    PBD::string_to_uint64 (route_id, numeric_id)) {
+		std::shared_ptr<Route> route = session->route_by_id (PBD::ID (numeric_id));
+		if (route) {
+			std::shared_ptr<Processor> processor = route->nth_plugin (plugin_index - 1);
+			std::shared_ptr<PluginInsert> insert = std::dynamic_pointer_cast<PluginInsert> (processor);
+			if (insert && insert->plugin ()->name () == expected_name) {
+				if (std::shared_ptr<Processor> old = _procontrol_plugin_window.lock ()) {
+					if (old != processor) { old->HideUI (); }
+				}
+				processor->ShowUI ();
+				_procontrol_plugin_window = processor;
+				char* url = lo_address_get_url (get_address (msg));
+				_procontrol_plugin_owner = url ? url : "";
+				free (url);
+				result = 1;
+			}
+		}
+	}
+	lo_send (get_address (msg), X_("/procontrol/plugin_ui/result"), "ssisi",
+	         expected_session.c_str (), route_id.c_str (), plugin_index, expected_name.c_str (), result);
+	return 0;
+}
